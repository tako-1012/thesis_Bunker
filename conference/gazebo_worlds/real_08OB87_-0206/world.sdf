<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="beach">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.85 0.95 1</background>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 -0.5 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>
    <model name="terrain">
      <static>true</static>
      <pose>99.75 99.75 -1.2999999523162842 0 0 0</pose>
      <link name="terrain_link">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>heightmap.png</uri>
              <size>200 200 8.0999524593353271</size>
              <pos>0 0 0</pos>
              <sampling>1</sampling>
            </heightmap>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <uri>heightmap.png</uri>
              <size>200 200 8.0999524593353271</size>
              <pos>0 0 0</pos>
              <sampling>1</sampling>
            </heightmap>
          </geometry>
          <material>
            <ambient>0.65 0.55 0.35 1</ambient>
            <diffuse>0.75 0.65 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="water">
      <static>true</static>
      <pose>99.75 99.75 0 0 0 0</pose>
      <link name="water_link">
        <visual name="water_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
